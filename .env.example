# .env.example - TEMPLATE of the settings this project needs.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored; this file is not.
# Never put real passwords in this file.

# Which database the dashboard (and DB_TYPE-based tools) read from: postgres | snowflake
DB_TYPE=postgres

# Which databases the loader writes raw data to (comma-separated): postgres | snowflake | postgres,snowflake
LOAD_TARGETS=postgres

# --- PostgreSQL (Neon / Supabase) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# --- Snowflake (optional - only needed when LOAD_TARGETS or DB_TYPE includes snowflake) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=RAW

# --- Data source: free key from https://data.gov.in (sign up -> My Account -> API key) ---
DATA_GOV_API_KEY=
