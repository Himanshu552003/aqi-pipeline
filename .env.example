# .env.example - TEMPLATE of the settings this project needs.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored; this file is not.
# Never put real passwords in this file.

# Which database the app/dashboard reads from: postgres | snowflake
DB_TYPE=postgres

# --- PostgreSQL (Supabase / Neon) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# --- Snowflake (filled in Phase 3 - do not start the trial yet) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=RAW

# --- Data source (filled in Phase 1) ---
DATA_GOV_API_KEY=
